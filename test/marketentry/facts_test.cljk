(ns marketentry.facts-test
  (:require [kotoba.test :refer [deftest is testing]]
            [marketentry.facts :as facts]))

(deftest sle-has-spec-basis
  (let [sb (facts/spec-basis "SLE")]
    (is (some? sb))
    (is (string? (:provenance sb)))
    (is (seq (:required-evidence sb)))
    (is (some? (facts/corporate-number-spec-basis "SLE")))
    (is (some? (facts/margin-of-preference-spec-basis "SLE")))))

(deftest sle-rep-spec-basis-is-honestly-absent
  (testing "no Sierra-Leone-specific representative/director exclusion-extension provision could be independently confirmed this iteration -- deliberately not claimed"
    (is (nil? (facts/rep-spec-basis "SLE")))))

(deftest unknown-jurisdiction-has-no-spec-basis
  (is (nil? (facts/spec-basis "ATL")))
  (is (nil? (facts/spec-basis "ZZZ"))))

(deftest required-evidence-satisfied
  (let [sb (facts/spec-basis "SLE")
        all (:required-evidence sb)]
    (is (true? (facts/required-evidence-satisfied? "SLE" all)))
    (is (not (facts/required-evidence-satisfied? "SLE" (take 1 all))))
    (is (nil? (facts/required-evidence-satisfied? "ATL" all)))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["SLE" "USA" "ATL"])]
    (is (= 3 (:requested c)))
    (is (= 2 (:covered c)))
    (is (= ["ATL"] (:missing-jurisdictions c)))))

(deftest margin-of-preference-spec-basis-criteria
  (let [mop (facts/margin-of-preference-spec-basis "SLE")]
    (is (= 5 (get-in mop [:margin-of-preference-criteria :pct-floor])))
    (is (= 12 (get-in mop [:margin-of-preference-criteria :pct-ceiling])))
    (is (contains? (get-in mop [:margin-of-preference-criteria :recognized-eligibility-grounds]) :ownership))
    (is (contains? (get-in mop [:margin-of-preference-criteria :recognized-eligibility-grounds]) :origin-of-labour))))
